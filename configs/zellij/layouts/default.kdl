// https://github.com/wiraki/dotfiles/blob/main/private_dot_config/zellij/layouts/default.kdl

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            // plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm"
            plugin location="zjstatus" {
                format_left   " {mode}#[bg=#101C2C] {tabs}"
                format_center ""
                // format_right  "{command_cpu} #[fg=#494d64]⋮ {command_memo} "
                format_right  "#[bg=#101C2C,fg=#494d64,italic]{session} "

                // -- mode -----
                mode_normal        "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#101C2C,fg=#FEA871,bold]"
                mode_locked        "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#101C2C,fg=#FEA871,bold]"
                mode_pane          "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#FEA871,fg=#101C2C,bold]Pane#[bg=#101C2C,fg=#FEA871,bold]"
                mode_renamepane    "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#FEA871,fg=#101C2C,bold]Rename Pane#[bg=#101C2C,fg=#FEA871,bold]"
                mode_resize        "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#FEA871,fg=#101C2C,bold]Resize#[bg=#101C2C,fg=#FEA871,bold]"
                mode_move          "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#FEA871,fg=#101C2C,bold]Move#[bg=#101C2C,fg=#FEA871,bold]"
                mode_tab           "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#FEA871,fg=#101C2C,bold]Tab#[bg=#101C2C,fg=#FEA871,bold]"
                mode_scroll        "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#FEA871,fg=#101C2C,bold]Scroll#[bg=#101C2C,fg=#FEA871,bold]"
                mode_search        "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#FEA871,fg=#101C2C,bold]Search#[bg=#101C2C,fg=#FEA871,bold]"
                mode_entersearch  "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#FEA871,fg=#101C2C,bold]Enter Search#[bg=#101C2C,fg=#FEA871,bold]"
                mode_renametab    "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#FEA871,fg=#101C2C,bold]Rename Tab#[bg=#101C2C,fg=#FEA871,bold]"
                mode_session       "#[bg=#101C2C,fg=#FEA871]#[bg=#FEA871,fg=#101C2C,bold] #[bg=#FEA871,fg=#101C2C,bold]Session#[bg=#101C2C,fg=#FEA871,bold]"

                // -- tab -----
                tab_normal              "#[bg=#101C2C,fg=#363a4f]#[bg=#363a4f,fg=#eed49f,bold]{name}{floating_indicator}#[bg=#101C2C,fg=#363a4f,bold]"
                tab_normal_fullscreen   "#[bg=#101C2C,fg=#363a4f]#[bg=#363a4f,fg=#eed49f,bold]{name}{fullscreen_indicator}#[bg=#101C2C,fg=#363a4f,bold]"
                tab_normal_sync         "#[bg=#101C2C,fg=#363a4f]#[bg=#363a4f,fg=#eed49f,bold]{name}{sync_indicator}#[bg=#101C2C,fg=#363a4f,bold]"
                tab_active              "#[bg=#101C2C,fg=#eed49f]#[bg=#eed49f,fg=#363a4f,bold]{name}{floating_indicator}#[bg=#101C2C,fg=#eed49f,bold]"
                tab_active_fullscreen   "#[bg=#101C2C,fg=#eed49f]#[bg=#eed49f,fg=#363a4f,bold]{name}{fullscreen_indicator}#[bg=#101C2C,fg=#eed49f,bold]"
                tab_active_sync         "#[bg=#101C2C,fg=#eed49f]#[bg=#eed49f,fg=#363a4f,bold]{name}{sync_indicator}#[bg=#101C2C,fg=#eed49f,bold]"
                tab_separator           "#[bg=#101C2C] "
                tab_sync_indicator       "  "
                tab_fullscreen_indicator " 󰊓 "
                tab_floating_indicator   " 󰹙 "
                tab_truncate_start_format "  +{count}  "
                tab_truncate_end_format   "   +{count} "

                command_memo_command    "bash /Users/neo/Developer/dotfiles/zellij/scripts/mem.sh"
                command_memo_format     "#[fg=#494d64] {stdout}"
                command_memo_interval   "30"
                command_memo_rendermode "static"

                command_cpu_command    "bash /Users/neo/Developer/dotfiles/zellij/scripts/cpu.sh"
                command_cpu_format     "#[fg=#494d64] {stdout}%"
                command_cpu_interval   "30"
                command_cpu_rendermode "static"

                hide_frame_for_single_pane "false"
                border_enabled  "false"
            }
        }
    }

    // -------------------------------------------------------------------------------------
    // Definition of tabs
    // -------------------------------------------------------------------------------------

    tab name="Main" split_direction="vertical" borderless=true {
        pane focus=true name=" " borderless=false
    }
}
